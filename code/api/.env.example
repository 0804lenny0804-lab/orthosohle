# Local synthetic-account development only. Explicitly opt in.
LOCAL_AUTH_ENABLED=true
AUTH_BASE_URL=http://127.0.0.1:3000
# Generate a random secret locally; never commit its value.
BETTER_AUTH_SECRET=
# Optional absolute path; default is code/api/data/local/auth.sqlite
# AUTH_DATABASE_PATH=/absolute/local/path/auth.sqlite
